{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "temperature": 0.1,
    },
    "build": {
      "temperature": 0.3,
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
  },
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cat *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git reset *": "deny",
    },
    "external_directory": {
      "*": "deny",
      "~/.agents/skills/**": "allow",
    },
  },
  "autoupdate": true,
  "lsp": true,
}
