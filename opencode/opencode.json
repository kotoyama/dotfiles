{
  "$schema": "https://opencode.ai/config.json",
  "model": "bai/glm-5.3-flash",
  "default_agent": "plan",
  "provider": {
    "bai": {
      "name": "B.AI",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "glm-5.3-flash": {
          "name": "B.AI GLM-5.3-Flash (B.AI)"
        }
      },
      "options": {
        "baseURL": "https://api.b.ai/v1"
      }
    }
  },
  "agent": {
    "plan": {
      "temperature": 0.1
    },
    "build": {
      "temperature": 0.3
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "tokensave": {
      "type": "local",
      "command": ["/opt/homebrew/bin/tokensave", "serve"]
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "cat *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git reset *": "deny"
    },
    "external_directory": {
      "*": "deny",
      "~/.agents/skills/**": "allow"
    }
  },
  "autoupdate": true,
  "lsp": true,
  "instructions": ["/Users/kotoyama/.config/opencode/tokensave.md"]
}
